# Copy to env.sh, fill in the values, then run: source env.sh
# Rules: no spaces around "=", keep the single quotes around the SMTP JSON.
# Must be sourced from the project folder (AIRFLOW_HOME uses the current folder).

export AIRFLOW_HOME=$PWD
export AIRFLOW__CORE__LOAD_EXAMPLES=False

# macOS only: prevents task crashes (SIGSEGV) in forked processes
export NO_PROXY="*"
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Gmail SMTP connection used by EmailOperator (connection id: smtp_default)
export AIRFLOW_CONN_SMTP_DEFAULT='{"conn_type":"smtp","host":"smtp.gmail.com","port":587,"login":"YOUREMAIL@gmail.com","password":"YOUR_16_CHAR_APP_PASSWORD","extra":{"disable_ssl":true,"from_email":"YOUREMAIL@gmail.com"}}'

# Read by dags/Flask_API.py
export AIRFLOW_WEBSERVER=http://localhost:8080
export AIRFLOW_USERNAME=admin
export AIRFLOW_PASSWORD=PASTE_FROM_simple_auth_manager_passwords.json.generated
export TARGET_DAG_ID=Training_Model_Pipeline
